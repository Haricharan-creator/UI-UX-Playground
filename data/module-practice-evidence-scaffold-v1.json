{
  "version": "1.0",
  "status": "provisional-practice-evidence-scaffold",
  "purpose": "Additive scaffold for Module -> Practice -> Tool Task -> Evidence -> Review -> Rework -> Validation. It does not rewrite, merge, delete, or replace existing lesson content.",
