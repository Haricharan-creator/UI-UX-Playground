{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"HACHARA Rework Record",
  "type":"object",
  "required":["id","evidenceId","versions","feedback","status"],
  "properties":{
    "id":{"type":"string"},
    "evidenceId":{"type":"string"},
    "versions":{"type":"array","minItems":1,"items":{"type":"object","required":["version","preserved"],"properties":{"version":{"type":"string"},"artifactRef":{"type":"string"},"preserved":{"type":"boolean"},"summary":{"type":"string"}}}},
    "feedback":{"type":"array","items":{"type":"object","required":["findingId","action"],"properties":{"findingId":{"type":"string"},"action":{"enum":["accept","modify","question","defer"]},"reason":{"type":"string"}}}},
    "changes":{"type":"array","items":{"type":"string"}},
    "reflection":{"type":"string"},
    "status":{"enum":["not-started","in-progress","resubmitted","validated"]},
    "validation":{"type":"object","properties":{"validatedBy":{"type":"string"},"notes":{"type":"string"},"date":{"type":"string"}},"additionalProperties":false}
  },
  "additionalProperties":false
}
